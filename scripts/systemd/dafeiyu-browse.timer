# 09:30 every morning in her TZ (decision 9). The deploy script's drop-in tz.conf re-states
# OnCalendar with the user's timezone, as for the nightly timer.
[Unit]
Description=Dafeiyu daily browse at 09:30

[Timer]
OnCalendar=*-*-* 09:30:00
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
