# Copy to .env and fill in (install.sh does this for you). .env is ignored by git.
DEEPSEEK_API_KEY=sk-your-key-here
# Her clock: the timezone YOU live in (matters when she runs on a machine elsewhere)
TZ=Asia/Shanghai
# How she refers to you in her notes and prompts: 他 or 她
FISH_OWNER=他
# May she message you first on WeChat (decision 10)? 1 = yes, 0 = never. And how often.
# FISH_REACH_OUT=1
# FISH_REACH_MAX=2
# Optional overrides (defaults shown)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# FISH_DB_PATH=data/fish.db
# Where she lives, as "lat,lon", when the machine's own city is wrong (a cloud server).
# Rounded to about a kilometre; no street address is ever stored (decision 15).
# FISH_HOME=31.23,121.47
