#!/bin/sh
# Mechanical checks, run only when the staged change touches documents.
staged=$(git diff --cached --name-only)

case "$staged" in
    *docs/*|*STATUS.md*|*AGENTS.md*|*README.md*)
        if ! python3 scripts/check_doc_structure.py; then
            echo "" >&2
            echo "commit rejected: see docs/writing_guide_zh.md §5." >&2
            exit 1
        fi
        ;;
esac
exit 0
